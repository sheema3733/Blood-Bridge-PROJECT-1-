# BloodBridge Platform Environment Configuration Example
# Copy this file to .env and adjust values as needed. NEVER commit .env to version control.

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Client URL (for CORS and WebSocket authorization)
CLIENT_URL=http://localhost:5173

# Security & Authentication
# Note: Use a strong, random secret string in production environments.
JWT_SECRET=bloodbridge_dev_jwt_secret_key_change_in_production_98765
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite file-based database for zero external dependencies)
DATABASE_URL="file:./dev.db"

# Platform Settings
EMERGENCY_TIMEOUT_STAGE1_MINUTES=10
EMERGENCY_TIMEOUT_STAGE2_MINUTES=20
EMERGENCY_TIMEOUT_STAGE3_MINUTES=30
EMERGENCY_RADIUS_STAGE1_KM=3
EMERGENCY_RADIUS_STAGE2_KM=7
EMERGENCY_RADIUS_STAGE3_KM=15
DUPLICATE_SIMILARITY_THRESHOLD=70
